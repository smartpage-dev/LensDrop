# Reference values ONLY. Enter real values in Hostinger Environment Variables.
# No .env file is automatically loaded. Never upload a file containing live secrets.
NODE_ENV=production
HOST=0.0.0.0
LENSDROP_ADMIN_KEY=REPLACE_WITH_A_PRIVATE_RANDOM_64_HEX_SECRET
LENSDROP_DATA_DIR=/CONFIRMED_PATH/lensdrop-data
LENSDROP_STORAGE_ID=REPLACE_WITH_RANDOM_32_LOWERCASE_HEX_ID
LENSDROP_INITIALIZE_STORAGE=0
LENSDROP_EVENT_QUOTA_BYTES=10737418240
LENSDROP_FREE_RESERVE_BYTES=536870912
# Set initialization to 1 only for a NEW EMPTY directory; change to 0 immediately
# after first verification and before the persistence redeploy test.
# Do not set PORT unless Hostinger explicitly requires it. Respect its assigned port.
